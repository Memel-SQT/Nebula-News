{
  "name": "nebula-news",
  "version": "0.1.0",
  "description": "Daily world news briefing, aggregated from neutral French/English sources, in a premium dark cosmic UI.",
  "author": "Nebula News",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "ingest": "tsx scripts/run-ingestion.ts",
    "electron:dev": "electron .",
    "build:template-db": "node scripts/build-template-db.mjs",
    "build:desktop": "npm run build && node scripts/prepare-desktop-build.mjs && npm run build:template-db && electron-builder --win"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "clsx": "^2.1.1",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "build": {
    "appId": "news.nebula.desktop",
    "productName": "Nebula News",
    "asar": true,
    "directories": {
      "output": "dist-desktop"
    },
    "files": ["desktop/**/*", "package.json"],
    "extraResources": [{ "from": "prisma/template.db", "to": "template.db" }],
    "afterPack": "./scripts/after-pack.cjs",
    "win": {
      "target": ["nsis"],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "electron-winstaller@5.4.0": true
  }
}
