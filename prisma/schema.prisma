// Nebula News data model.
//
// Design notes:
// - Region/Language/Category are Prisma enums rather than free-standing
//   tables. They map 1:1 onto UI filters and ingestion logic, are a small
//   fixed set, and enums keep filtering/indexing simple and fast. The
//   source list itself (the thing the brief asks to keep "configurable")
//   lives in `lib/sources/config.ts` as version-controlled code, then gets
//   synced into the `Source` table by `prisma/seed.ts` so it can also be
//   joined/queried/reported on.
// - Category is still a join table (ArticleCategory) rather than a plain
//   enum column on Article, because one article commonly carries more than
//   one topic tag (e.g. an article can be both Economy and Tech).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Region {
  FRANCE
  NORTH_AMERICA
  ANGLOSAXON
  GLOBAL
}

enum Language {
  FR
  EN
}

enum CategoryKey {
  WORLD
  POLITICS
  ECONOMY
  TECH
  SCIENCE
  CULTURE
  ENVIRONMENT
  SPORTS
  HEALTH
}

model Source {
  id         String         @id @default(cuid())
  name       String
  feedUrl    String         @unique
  websiteUrl String
  region     Region
  language   Language
  // Editorial weight used by the importance-scoring step: wire services and
  // flagship outlets are seeded higher than smaller/independent sources.
  weight     Float          @default(1.0)
  active     Boolean        @default(true)
  articles   Article[]
  logs       IngestionLog[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Article {
  id              String            @id @default(cuid())
  title           String
  originalUrl     String            @unique
  sourceId        String
  source          Source            @relation(fields: [sourceId], references: [id])
  region          Region
  language        Language
  publishedAt     DateTime
  rawContent      String?
  summary         String?
  imageUrl        String?
  importanceScore Float             @default(0)
  isBriefingPick  Boolean           @default(false)
  categories      ArticleCategory[]
  favorites       Favorite[]
  createdAt       DateTime          @default(now())

  @@index([publishedAt])
  @@index([region])
  @@index([language])
  @@index([importanceScore])
  @@index([isBriefingPick, publishedAt])
}

model Category {
  id       String            @id @default(cuid())
  key      CategoryKey       @unique
  articles ArticleCategory[]
}

model ArticleCategory {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
}

model IngestionLog {
  id            String    @id @default(cuid())
  sourceId      String?
  source        Source?   @relation(fields: [sourceId], references: [id])
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String // "success" | "error" | "partial"
  itemsFetched  Int       @default(0)
  itemsInserted Int       @default(0)
  errorMessage  String?
}

// Auth is intentionally not wired up (see README) but the schema is ready
// for Auth.js/Clerk: point their adapter at `User`, then favorites work.
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  favorites Favorite[]
  createdAt DateTime   @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}
