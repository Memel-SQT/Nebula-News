// Nebula News data model.
//
// Design notes:
// - Region/Language/Category are Prisma enums rather than free-standing
//   tables. They map 1:1 onto UI filters and ingestion logic, are a small
//   fixed set, and enums keep filtering/indexing simple and fast. The
//   source list itself (the thing the brief asks to keep "configurable")
//   lives in `lib/sources/config.ts` as version-controlled code, then gets
//   synced into the `Source` table by `prisma/seed.ts` so it can also be
//   joined/queried/reported on.
// - Category is still a join table (ArticleCategory) rather than a plain
//   enum column on Article, because one article commonly carries more than
//   one topic tag (e.g. an article can be both Economy and Tech).
// - Datasource is SQLite: the shipped desktop build is zero-config (a local
//   file under the OS app-data folder, like the original Nebula app's
//   %LOCALAPPDATA%\Nebula\nebula.db), no Postgres server to run or host.
//   SQLite has no native enum support at all (unlike Postgres), so
//   Region/Language/CategoryKey are plain strings here, validated by the
//   TypeScript union types in types/index.ts instead of a DB-level enum.
//   Swapping back to `postgresql` for a hosted web deployment is a
//   one-line provider change (see README); reintroducing real `enum`
//   blocks there is optional at that point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Source {
  id         String         @id @default(cuid())
  name       String
  feedUrl    String         @unique
  websiteUrl String
  region     String
  language   String
  // Editorial weight used by the importance-scoring step: wire services and
  // flagship outlets are seeded higher than smaller/independent sources.
  weight     Float          @default(1.0)
  active     Boolean        @default(true)
  articles   Article[]
  logs       IngestionLog[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Article {
  id              String            @id @default(cuid())
  title           String
  originalUrl     String            @unique
  sourceId        String
  source          Source            @relation(fields: [sourceId], references: [id])
  region          String
  language        String
  publishedAt     DateTime
  rawContent      String?
  summary         String?
  imageUrl        String?
  importanceScore Float             @default(0)
  isBriefingPick  Boolean           @default(false)
  categories      ArticleCategory[]
  favorites       Favorite[]
  createdAt       DateTime          @default(now())

  @@index([publishedAt])
  @@index([region])
  @@index([language])
  @@index([importanceScore])
  @@index([isBriefingPick, publishedAt])
}

model Category {
  id       String            @id @default(cuid())
  key      String            @unique
  articles ArticleCategory[]
}

model ArticleCategory {
  articleId  String
  categoryId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
}

model IngestionLog {
  id            String    @id @default(cuid())
  sourceId      String?
  source        Source?   @relation(fields: [sourceId], references: [id])
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String // "success" | "error" | "partial"
  itemsFetched  Int       @default(0)
  itemsInserted Int       @default(0)
  errorMessage  String?
}

// Auth is intentionally not wired up (see README) but the schema is ready
// for Auth.js/Clerk: point their adapter at `User`, then favorites work.
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  favorites Favorite[]
  createdAt DateTime   @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
}
