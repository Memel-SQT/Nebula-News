# SQLite file (zero-config, used by the desktop build and local dev).
# The packaged desktop app overrides this itself, pointing at a DB file
# under the OS app-data folder — this value is only for `npm run dev`.
DATABASE_URL="file:./dev.db"

# To deploy as a hosted web app instead of the desktop build, switch
# `datasource db { provider = ... }` in prisma/schema.prisma back to
# "postgresql" and point this at a real Postgres instance (Neon/Supabase/
# Railway/etc).

# Secret required as a Bearer token / ?secret= query param to trigger POST /api/ingest.
# Vercel Cron requests are authenticated automatically by Vercel and don't need this,
# but any manual or third-party trigger does.
INGEST_SECRET="change-me"

# Optional: enables LLM-based summarization/classification via the Claude API.
# Without it, ingestion falls back to the built-in extractive summarizer and
# keyword-based classifier, so the app runs fully without this key.
ANTHROPIC_API_KEY=""
